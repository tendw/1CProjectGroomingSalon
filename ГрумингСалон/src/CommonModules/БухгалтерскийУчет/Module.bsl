
#Область ПрограммныйИнтерфейс

// Заполняет первый вид субконто счета указанным значением.
//
// Параметры:
//  Счет - ПланСчетовСсылка.Хозрасчетный - счет, по которому определяется вид субконто.
//  КоллекцияСубконто - РегистрБухгалтерииСубконто.Хозрасчетный - субконто Дт или Кт движения.
//  ЗначениеСубконто - Произвольный - значение, записываемое в субконто.
//
Процедура ЗаполнитьСубконтоПоСчету(Счет, КоллекцияСубконто, ЗначениеСубконто) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;
	
	ВидыСубконто = Счет.ВидыСубконто;
	Если ВидыСубконто.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияСубконто[ВидыСубконто[0].ВидСубконто] = ЗначениеСубконто;
	
КонецПроцедуры

#КонецОбласти
