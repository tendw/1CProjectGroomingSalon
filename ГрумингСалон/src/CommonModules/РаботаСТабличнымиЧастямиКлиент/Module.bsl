
#Область ПрограммныйИнтерфейс

// Пересчитывает сумму в строке табличной части как Цена * Количество.
//
// Параметры:
//  СтрокаТабличнойЧасти - СтрокаТабличнойЧасти - строка с реквизитами Цена, Количество, Сумма.
//
Процедура ПересчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТабличнойЧасти) Экспорт
	
	СтрокаТабличнойЧасти.Сумма = Окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество,
		2, РежимОкругления.Окр15как20);
	
КонецПроцедуры

#КонецОбласти
