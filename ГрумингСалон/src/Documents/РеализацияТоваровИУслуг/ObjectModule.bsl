
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Запрет = Константы.ЗапретПроведенияПриОтрицательныхОстатках.Получить();
	
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.УчетЗатрат.Записывать = Истина;
	Движения.ЗаказыКлиентов.Записывать = Истина;
	Движения.Хозрасчетный.Записывать = Истина;
	
	Движения.ТоварыНаСкладах.Записать();
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ТоварыНаСкладах");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Товар");
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровИУслугТовары.Товар КАК Товар,
	|	СУММА(РеализацияТоваровИУслугТовары.Сумма) КАК Сумма,
	|	СУММА(РеализацияТоваровИУслугТовары.Количество) КАК Количество,
	|	РеализацияТоваровИУслугТовары.Ссылка.Склад КАК Склад
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары
	|ГДЕ
	|	РеализацияТоваровИУслугТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровИУслугТовары.Товар,
	|	РеализацияТоваровИУслугТовары.Ссылка.Склад
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровИУслугУслуги.Услуга,
	|	СУММА(РеализацияТоваровИУслугУслуги.Сумма),
	|	NULL,
	|	NULL
	|ИЗ
	|	Документ.РеализацияТоваровИУслуг.Услуги КАК РеализацияТоваровИУслугУслуги
	|ГДЕ
	|	РеализацияТоваровИУслугУслуги.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровИУслугУслуги.Услуга
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар,
	|	Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Товар КАК Товар,
	|	ВТ_Товары.Сумма КАК Сумма,
	|	ВТ_Товары.Количество КАК Количество,
	|	ВТ_Товары.Склад КАК Склад,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.СрокГодности, ДАТАВРЕМЯ(1, 1, 1)) КАК СрокГодности,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
	|	ВТ_Товары.Товар.СтатьяЗатрат КАК ТоварСтатьяЗатрат,
	|	ВЫБОР
	|		КОГДА ВТ_Товары.Товар.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоТовар,
	|	ВТ_Товары.Товар.Представление КАК ТоварПредставление,
	|	ВТ_Товары.Товар.СчетБухгалтерскогоУчета КАК СчетБухгалтерскогоУчета
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&МоментВремени,
	|				(Номенклатура, Склад) В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Товар КАК Товар,
	|						ВТ_Товары.Склад КАК Склад
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары)) КАК ТоварыНаСкладахОстатки
	|		ПО ВТ_Товары.Товар = ТоварыНаСкладахОстатки.Номенклатура
	|			И ВТ_Товары.Склад = ТоварыНаСкладахОстатки.Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыНаСкладахОстатки.СрокГодности
	|ИТОГИ
	|	МАКСИМУМ(Сумма),
	|	МАКСИМУМ(Количество),
	|	СУММА(КоличествоОстаток)
	|ПО
	|	ТоварСтатьяЗатрат,
	|	Товар";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени()));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ВыборкаСтатьяЗатрат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтатьяЗатрат.Следующий() Цикл
		
		СуммаПоСтатье = 0;
		ВыборкаТовар = ВыборкаСтатьяЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаТовар.Следующий() Цикл
			
			Если ВыборкаТовар.ЭтоТовар Тогда
				
				Превышение = ВыборкаТовар.Количество - ВыборкаТовар.КоличествоОстаток;
				
				Если Превышение > 0 Тогда
					//Сообщение = Новый СообщениеПользователю;
					Если Запрет Тогда
						ТекстСообщения = "Недостаточно товара ""%1"" на складе. Превышение состовляет ""%2""";
						Отказ = Истина;
					Иначе
						ТекстСообщения = "Внимание! По товару ""%1"" образовались отрицательные остатки в количестве ""%2""";
					КонецЕсли;
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, ВыборкаТовар.ТоварПредставление, Превышение));
					//Сообщение.Текст = СтрШаблон(ТекстСообщения, ВыборкаТовар.ТоварПредставление, Превышение);
					//Сообщение.Сообщить();
				КонецЕсли;
				
				Если Отказ Тогда
					Продолжить;
				КонецЕсли;
				
				ОсталосьСписать = ВыборкаТовар.Количество;
				ВыборкаДетальные = ВыборкаТовар.Выбрать();
				
				Пока ВыборкаДетальные.Следующий() И ОсталосьСписать > 0 Цикл
					Если ВыборкаДетальные.КоличествоОстаток <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Списываем = Мин(ВыборкаДетальные.КоличествоОстаток, ОсталосьСписать);
					
					Движение = Движения.ТоварыНаСкладах.ДобавитьРасход();
					Движение.Период = Дата;
					Движение.Номенклатура = ВыборкаДетальные.Товар;
					Движение.Склад = ВыборкаДетальные.Склад;
					Движение.СрокГодности = ВыборкаДетальные.СрокГодности;
					Движение.Количество = Списываем;
					
					Если Списываем = ВыборкаДетальные.КоличествоОстаток Тогда
						СуммаСписания = ВыборкаДетальные.СуммаОстаток;
					Иначе
						СуммаСписания = Списываем / ВыборкаДетальные.КоличествоОстаток * ВыборкаДетальные.СуммаОстаток;
					КонецЕсли;
					Движение.Сумма = СуммаСписания;
					
					ОсталосьСписать = ОсталосьСписать - Списываем;
					СуммаПоСтатье = СуммаПоСтатье + Движение.Сумма;
					
					//Проводка по списанию товаров и материалов Дт90 Кт10/41
					Движение = Движения.Хозрасчетный.Добавить();
					Движение.СчетДт = ПланыСчетов.Хозрасчетный.Продажи;
					Движение.СчетКт = ВыборкаТовар.СчетБухгалтерскогоУчета;
					Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура] = ВыборкаДетальные.Товар;
					Движение.Период = Дата;
					Движение.Сумма = СуммаСписания;
					Движение.Содержание = "Списана себестоимость товарно-материальных ценностей";
					
				КонецЦикла;
				
				Если ОсталосьСписать > 0 И НЕ Отказ Тогда
					ДвижениеПревышения = Движения.ТоварыНаСкладах.ДобавитьРасход();
					ДвижениеПревышения.Период = Дата;
					ДвижениеПревышения.Номенклатура = ВыборкаТовар.Товар;
					ДвижениеПревышения.Склад = Склад;
					ДвижениеПревышения.Количество = ОсталосьСписать;
					ДвижениеПревышения.Сумма = 0; 
					ДвижениеПревышения.СрокГодности = Дата(1, 1, 1);
				КонецЕсли;
				
			КонецЕсли;
			
			Движение = Движения.Продажи.Добавить();
			Движение.Период = Дата;
			Движение.Номенклатура = ВыборкаТовар.Товар;
			Движение.Сотрудник = Сотрудник;
			Движение.Клиент = Клиент;
			Движение.Сумма = ВыборкаТовар.Сумма;
			
		КонецЦикла;
		
		Если СуммаПоСтатье > 0 Тогда
			Движение = Движения.УчетЗатрат.Добавить();
			Движение.Период = Дата;
			Движение.СтатьяЗатрат = ВыборкаСтатьяЗатрат.ТоварСтатьяЗатрат;
			Движение.Сумма = СуммаПоСтатье;
		КонецЕсли;
		
	КонецЦикла;
	
	//Проводка по отражению выручки Дт62 Кт90
	Движение = Движения.Хозрасчетный.Добавить();
	Движение.СчетДт = ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
	Движение.СчетКт = ПланыСчетов.Хозрасчетный.Продажи;
	БухгалтерскийУчет.ЗаполнитьСубконтоПоСчету(Движение.СчетДт, Движение.СубконтоДт, Клиент);
	Движение.Период = Дата;
	Движение.Сумма = СуммаДокумента;
	Движение.Содержание = "Отражена выручка от реализации товаров и услуг";
	
	Если ЗначениеЗаполнено(Основание) Тогда 
		Движение = Движения.ЗаказыКлиентов.Добавить();
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Сотрудник = Сотрудник;
		Движение.ЗаписьКлиента = Основание;
		Движение.СуммаФакт = Услуги.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаписьКлиента") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Основание", ДанныеЗаполнения.Ссылка);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровИУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровИУслуг КАК РеализацияТоваровИУслуг
		|ГДЕ
		|	РеализацияТоваровИУслуг.Основание = &Основание
		|	И НЕ РеализацияТоваровИУслуг.ПометкаУдаления";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ТекстОшибки = СтрШаблон("Для документа уже введен документ реализации %1!", Выборка.Ссылка);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		Клиент = ДанныеЗаполнения.Клиент;
		Комментарий = ДанныеЗаполнения.Комментарий;
		Сотрудник = ДанныеЗаполнения.Сотрудник;
		Основание = ДанныеЗаполнения.Ссылка;
		
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.Сумма = ТекСтрокаУслуги.Стоимость;
			НоваяСтрока.Услуга = ТекСтрокаУслуги.Услуга;
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗначениеЗаполнено(Ссылка)
		И СтатусОплаты <> Перечисления.ОплатаДокумента.ПолностьюОплачен Тогда
		СтруктураОплаты = Документы.РеализацияТоваровИУслуг.ПроверитьОплатуДокумента(Ссылка);
		СтатусОплаты = СтруктураОплаты.СтатусОплаты;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЗначениеЗаполнено(Основание) Тогда
		ОбъектЗаписи = Основание.ПолучитьОбъект();
		ОбъектЗаписи.УслугаОказана = Истина;
		ОбъектЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

